#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

export AURA_SSM_REGION='${aws_region}'
ssm_config=/etc/amazon/ssm/amazon-ssm-agent.json
if [[ ! -f "$ssm_config" ]]; then
  cp /etc/amazon/ssm/amazon-ssm-agent.json.template "$ssm_config"
fi
python3 - "$ssm_config" <<'PY'
import json
import os
import sys

path = sys.argv[1]
with open(path, encoding="utf-8") as handle:
    config = json.load(handle)
agent = config.setdefault("Agent", {})
agent["Region"] = os.environ["AURA_SSM_REGION"]
agent["UseDualStackEndpoint"] = True
with open(path, "w", encoding="utf-8") as handle:
    json.dump(config, handle, indent=2)
    handle.write("\n")
PY
systemctl restart amazon-ssm-agent

dnf update -y
dnf install -y docker tar amazon-cloudwatch-agent
if ! docker compose version >/dev/null 2>&1; then
  compose_version='v5.6.0'
  compose_sha256='40343e21ca777173e69cff5dbafeb37c6f81f3b0d57d9e597f036e95eb63e76a'
  compose_path='/usr/local/lib/docker/cli-plugins/docker-compose'
  install -d -m 0755 "$(dirname "$compose_path")"
  for attempt in {1..12}; do
    if AWS_USE_DUALSTACK_ENDPOINT=true aws s3 cp \
      "s3://${backup_bucket}/bootstrap/docker-compose-linux-x86_64-$compose_version" \
      "$compose_path" --region '${aws_region}' --only-show-errors; then
      break
    fi
    sleep 10
  done
  echo "$compose_sha256  $compose_path" | sha256sum -c -
  chmod 0755 "$compose_path"
fi
systemctl enable --now docker

fetch_bootstrap() {
  local object_key="$1"
  local destination="$2"
  for attempt in {1..12}; do
    if AWS_USE_DUALSTACK_ENDPOINT=true aws s3 cp \
      "s3://${backup_bucket}/bootstrap/$object_key" "$destination" \
      --region '${aws_region}' --only-show-errors; then
      return 0
    fi
    sleep 10
  done
  echo "Unable to download verified bootstrap asset: $object_key" >&2
  return 1
}

# Bootstrap artifact set: ${bootstrap_assets_sha256}
fetch_bootstrap cloudwatch-agent.json /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json
chmod 0644 /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 -s \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json

install -d -m 0750 /srv/aura /srv/aura/data/chroma /srv/aura/logs /srv/aura/backups /etc/aura

cat > /etc/aura/deploy.env <<'EOF'
AWS_REGION=${aws_region}
AWS_ACCOUNT_ID=${account_id}
BACKUP_BUCKET=${backup_bucket}
BACKEND_RELEASE_PARAMETER=${backend_release_parameter_name}
PROXY_RELEASE_PARAMETER=${proxy_release_parameter_name}
FRONTEND_URL_PARAMETER=${frontend_url_parameter_name}
CLOUDFLARED_IMAGE_PARAMETER=${cloudflared_image_parameter_name}
CLOUDFLARE_TUNNEL_PARAMETER=${cloudflare_tunnel_parameter_name}
AURA_LOG_GROUP=${log_group_name}
EOF
chmod 0600 /etc/aura/deploy.env

cat > /etc/aura/runtime-secret-parameters <<'EOF'
${runtime_secret_parameters}
EOF
chmod 0600 /etc/aura/runtime-secret-parameters

fetch_bootstrap docker-compose.aws.yml /srv/aura/docker-compose.aws.yml
fetch_bootstrap aura-refresh /usr/local/bin/aura-refresh
fetch_bootstrap aura-backup /usr/local/bin/aura-backup
fetch_bootstrap aura-restore /usr/local/bin/aura-restore
fetch_bootstrap aura-rollback /usr/local/bin/aura-rollback
chmod 0700 /usr/local/bin/aura-refresh /usr/local/bin/aura-backup /usr/local/bin/aura-restore /usr/local/bin/aura-rollback

cat > /etc/systemd/system/aura-backup.service <<'EOF'
[Unit]
Description=AURA encrypted daily data backup
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/aura-backup
EOF

cat > /etc/systemd/system/aura-backup.timer <<'EOF'
[Unit]
Description=Run AURA backup once per day

[Timer]
OnCalendar=*-*-* 02:15:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
EOF

systemctl daemon-reload
systemctl enable --now aura-backup.timer

# The image and tunnel token are intentionally unavailable until their SSM
# parameters are populated. A release workflow invokes aura-refresh via SSM.
