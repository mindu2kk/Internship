# ---------------------------------------------------------------------------
# AURA AI Sales Advisor - Git ignore rules
# Keep source, documentation, tests, and small reproducible catalog assets.
# Ignore secrets, local runtime state, generated artifacts, caches, and builds.
# ---------------------------------------------------------------------------

# Environment variables and secrets
.env
.env.*
*.env
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
.python-version
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.pytest_cache/
.hypothesis/
.tox/
.nox/

# Python packaging/build output
build/
dist/
sdist/
wheelhouse/
*.egg
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/
.virtualenv/

# Test and coverage artifacts
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
*.py,cover
nosetests.xml
junit.xml
test-results/
playwright-report/
coverage/

# Node / frontend artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.eslintcache
frontend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime databases and generated stores
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
chroma_db/
.chromadb/

# Logs and local outputs
logs/
output/
tmp/
temp/
*.tmp
*.temp
*.log
*.log.*

# Local helper scripts that are not part of the canonical GitHub workflow
*.bat
start.sh
stop.sh

# Optional deployment/build helpers not needed in the submitted SourceCode tree
Dockerfile.*
docker-compose.yml
Makefile

# Data files that are local, raw, or too large for normal Git history
data/product_catalog_raw.xlsx
data/product_catalog_raw.csv
data/**/*.tmp
data/**/*.bak
data/**/*.zip
data/**/*.7z
data/**/*.rar

# Generated media/export artifacts
*.bak
*.orig
*.rej
*.pid
*.seed
*.dump
*.trace
*.prof
*.png.tmp
*.pdf.tmp

# IDE/editor folders
.vscode/
.idea/
.fleet/
.cursor/
*.swp
*.swo
*~

# Tool-specific local state
.kiro/
.codex/

# Local archive/scratch material kept outside the GitHub source submission
archive/
tools/scratch/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Docker/local compose overrides
docker-compose.override.yml
*.dockerignore.bak

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Keep only the public root README tracked. Other Markdown notes are local docs,
# report drafts, archived notes, or generated documentation.
*.md
!/README.md
